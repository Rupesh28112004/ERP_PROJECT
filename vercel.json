{
  "projectSettings": {
    "sourceFilesOutsideRootDirectory": true
  },
  "buildCommand": "cd project && npm install && npm run build",
  "outputDirectory": "project/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/handler.js?path=/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
